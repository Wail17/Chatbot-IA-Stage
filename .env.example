# API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# App
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here
DEBUG=true

# AI Settings
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_MODEL_FAST=claude-haiku-4-20250514
CLAUDE_MODEL_SMART=claude-sonnet-4-20250514

# Thresholds
CONFIDENCE_THRESHOLD_DIRECT=0.85
CONFIDENCE_THRESHOLD_SMART=0.60
MAX_TOKENS=1000

# Languages
SUPPORTED_LANGUAGES=nl,fr,en,da
DEFAULT_LANGUAGE=nl

# Feature Flags Dates
FEATURE_MULTILINGUAL_DATE=2025-03-14
FEATURE_B2B_DATE=2025-03-28
FEATURE_CALCULATOR_DATE=2025-04-18
FEATURE_YOUTUBE_DATE=2025-05-02
FEATURE_CRM_DATE=2025-05-22

# Learning
MIN_PATTERN_CLUSTER_SIZE=5
AUTO_DRAFT_THRESHOLD=0.80
NIGHTLY_LEARNING_ENABLED=true
NIGHTLY_LEARNING_HOUR=2

# Feature Overrides (manual)
# FEATURE_MULTILINGUAL_ENABLED=true
# FEATURE_B2B_ENABLED=true
